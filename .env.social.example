# Copy to .env.social and fill in real credentials.
# Do not commit .env.social.

# Meta / Facebook / Instagram
META_GRAPH_VERSION=v24.0
META_APP_ID=
META_APP_SECRET=
META_USER_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# Google Business Profile
GOOGLE_BIZ_ACCOUNT_ID=
GOOGLE_BIZ_LOCATION_ID=

# Option A: short-lived/manual token
GOOGLE_ACCESS_TOKEN=

# Option B: automated refresh token flow
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
