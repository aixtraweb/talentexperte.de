# Copy to .env.automation on the Mac mini and adjust paths/settings.
# Do not commit .env.automation.

PROJECT_DIR=/Users/alejandromedina/TALENTEXPERTE/talenexperte.de
PUBLIC_BASE_URL=https://www.talentexperte.de
PYTHON_BIN=/Users/alejandromedina/TALENTEXPERTE/talenexperte.de/.venv/bin/python3

# Notification after each automation run.
ENABLE_MACOS_NOTIFICATION=1
NOTIFY_EMAIL=
NOTIFY_WEBHOOK_URL=

# Phase 1 default: create drafts/previews only.
# Set to 1 later if the weekly job should write public blog files.
AUTO_PUBLISH_BLOG=0

# Set to 1 later if the weekly job should deploy and publish social posts.
AUTO_DEPLOY=0
AUTO_POST_SOCIAL=0

# Optional if a future version should use an LLM provider.
OPENAI_API_KEY=
